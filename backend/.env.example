# 本地开发 = john-server 测试库（需 Tailscale 可达 john-server:5432）
APP_NAME=John Algorithm
DEBUG=true
TESTING=false
DATABASE_URL=postgresql+psycopg://john-algorithm:john-algorithm-123@john-server:5432/john-algorithm-test
USE_MIGRATIONS=true

JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=false
SMTP_USE_SSL=true
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=60
AUTH_EXPOSE_CODES=true

REDIS_URL=redis://john-server:6379/2
SYNC_API_KEY=dev-sync-key

CORS_ORIGINS=http://localhost:3004,http://127.0.0.1:3004

# Portainer 生产（Docker 内网，仅供对照，勿用于本地 .env）:
# DATABASE_URL=postgresql+psycopg://john-algorithm:john-algorithm-123@john-postgresql:5432/john-algorithm
# REDIS_URL=redis://john-redis:6379/2
# AUTH_EXPOSE_CODES=false
