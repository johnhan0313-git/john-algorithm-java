# 复制到 john-server: ~/apps/john-algorithm-java/.env.prod
# deploy-john-server.sh 会读取此文件注入 docker compose 变量

JWT_SECRET=change-me-in-production
SYNC_API_KEY=change-me-sync-key

SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# 按需修改（域名 / IP）
# CORS_ORIGINS=https://sf.cool-app.me,http://sf.cool-app.me

